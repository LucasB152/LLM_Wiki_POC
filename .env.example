# Configuration unique du projet : lue par docker-compose.yml ET par l'API en local
# (pnpm start:dev, prisma, tests). Copier ce fichier en .env.

# ---- API en local ----
# Dans Docker, ces deux valeurs sont remplacées par celles de docker-compose.yml.
FILES_DIR=data
DATABASE_URL=postgresql://wiki:wiki@localhost:5432/llmwiki

# Clé maître qui chiffre les clés API en base : openssl rand -base64 32
# Ne pas la changer ensuite : les clés stockées deviendraient illisibles.
API_KEY_ENCRYPTION_KEY=

# Origines autorisées par le CORS (vide : toutes)
# CORS_ORIGINS=http://localhost:5173

# ---- Ingestion automatique au démarrage de Docker (service "seed") ----
LLM_PROVIDER=GEMINI
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Sources de data/raw/ à ingérer, séparées par des espaces
# SEED_SOURCES=00-vue-ensemble-modeles-en-couches.md 01_couche_physique.md 02-couche-liaison-de-donnees.md
